% QUT-Beamer-Theme (UCM) — variante compacta para la defensa.
% Basado en el tema QUT (Jiayi Weng / THU-Beamer-Theme). Se conservan los
% "básicos" (azul institucional, frametitle, inner circles, divisores de
% sección y colores de bloque) y se hacen las BANDAS superior/inferior menos
% invasivas: una sola línea fina cada una y sin símbolos de navegación, para
% dar más espacio al contenido y evitar recortes de figuras.
\mode<presentation>

\ProcessOptionsBeamer

\useoutertheme{default}
\useinnertheme{circles}

% color institucional
\xdefinecolor{qut}{HTML}{00407a}  %PANTONE 541 BLUE

% sin símbolos de navegación (esquina inferior)
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{bibliography item}[text]
\setbeamertemplate{caption}[numbered]

% colores base
\setbeamercolor{structure}{fg=qut}
\setbeamercolor{title}{fg=qut}
\setbeamercolor{frametitle}{bg=qut,fg=white}
\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamercolor{item projected}{fg=white}

% paletas / titlelike
\setbeamercolor{palette primary}{use=structure,fg=white,bg=structure.fg}
\setbeamercolor{palette secondary}{use=structure,fg=white,bg=structure.fg!75!black}
\setbeamercolor{palette tertiary}{use=structure,fg=white,bg=structure.fg!50!black}
\setbeamercolor{palette quaternary}{fg=white,bg=structure.fg!50!black}
\setbeamercolor{titlelike}{parent=palette primary}
\setbeamercolor{block title}{bg=qut}
\setbeamercolor*{block title example}{use={normal text,example text},bg=white,fg=qut}

% --- Cabecera compacta: barra (una línea) con la sección actual ---
\setbeamercolor{ucmband}{bg=qut,fg=white}
\setbeamerfont{ucmband}{size=\scriptsize}
\setbeamertemplate{headline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.6ex,dp=1.1ex,%
      leftskip=.3cm,rightskip=.3cm]{ucmband}%
    \usebeamerfont{ucmband}\insertsectionhead%
    \hfill%
    \usebeamerfont{ucmband}\insertsubsectionhead%
  \end{beamercolorbox}%
}

% --- Frametitle: barra azul de una línea ---
\setbeamertemplate{frametitle}{%
  \nointerlineskip%
  \begin{beamercolorbox}[wd=\paperwidth,ht=3.0ex,dp=1.2ex,leftskip=.3cm,rightskip=.3cm]{frametitle}%
    \usebeamerfont{frametitle}\insertframetitle%
  \end{beamercolorbox}%
}

% --- Pie: una sola línea con más aire (autor · escuela · nº de diapositiva) ---
\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=3.2ex,dp=1.5ex,%
      leftskip=.3cm,rightskip=.3cm]{ucmband}%
    \usebeamerfont{ucmband}\insertshortauthor%
    \hfill%
    \usebeamerfont{ucmband}\insertshortinstitute%
    \hfill%
    \usebeamerfont{ucmband}\insertframenumber\,/\,\inserttotalframenumber%
  \end{beamercolorbox}%
}

% divisores de sección/subsección (se conservan de la plantilla original)
\AtBeginSection[]{
  \begin{frame}
    \tableofcontents[sectionstyle=show/shaded,subsectionstyle=show/shaded/hide,subsubsectionstyle=show/shaded/hide]
  \end{frame}
}
\AtBeginSubsection[]{
  \begin{frame}
    \tableofcontents[sectionstyle=show/shaded,subsectionstyle=show/shaded/hide,subsubsectionstyle=show/shaded/hide]
  \end{frame}
}

\mode
<all>
