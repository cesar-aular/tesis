# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- Virtual env ----
.venv/
venv/
env/

# ---- Data (regenerable via ETL; too heavy for VCS) ----
data/landing/
data/bronze/
data/silver/
data/gold/
data/temp/
data/**/*.parquet
data/**/*.csv

# ---- Trained models / checkpoints ----
models/**/nf_models/
models/**/*.ckpt
models/**/*.joblib
models/**/*.pkl
lightning_logs/

# ---- Results (regenerables por el pipeline; markers incluidos) ----
results/
visuales/**/*.png
visuales/**/*.jpg

# ---- Optuna / study dbs ----
*.db
*.sqlite3

# ---- LaTeX (artefactos de compilacion TeXworks/MiKTeX) ----
latex-tesis/tesis_check.*
latex-tesis/*.aux
latex-tesis/*.lof
latex-tesis/*.lot
latex-tesis/*.out
latex-tesis/*.toc
latex-tesis/*.bbl
latex-tesis/*.blg
latex-tesis/*.synctex.gz
latex-tesis/*.synctex(busy)
latex-tesis/*.fls
latex-tesis/*.fdb_latexmk

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.log

# ---- Keep structure of ignored dirs ----
!.gitkeep
